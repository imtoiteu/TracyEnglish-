# The SQLite database file, relative to apps/web/prisma.
DATABASE_URL="file:./tracy.db"

# Absolute URL of the deployment, used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL="https://tracyenglish.vn"

# Port for `npm run dev` and `npm run start`.
PORT=3000

# The scheme the site is actually served over decides whether the session cookie is marked
# `Secure`. A `Secure` cookie sent over plain HTTP is discarded by the browser, which logs
# everyone straight back out, so this must reflect reality rather than NODE_ENV.
#
# It is resolved in this order:
#   1. SESSION_COOKIE_SECURE below, if set to "true" or "false"
#   2. the x-forwarded-proto header, when a reverse proxy sets one
#   3. the scheme of APP_ORIGIN
#
# Behind an HTTPS proxy that sets x-forwarded-proto, none of this needs setting. Set APP_ORIGIN
# when TLS terminates somewhere that does not send that header. Use SESSION_COOKIE_SECURE only
# to force the issue.
APP_ORIGIN="https://tracyenglish.vn"
# SESSION_COOKIE_SECURE=false
