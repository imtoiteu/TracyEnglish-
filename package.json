{
  "name": "tracy-english",
  "version": "1.0.0",
  "private": true,
  "description": "Tracy English — an English learning platform and language centre built for Vietnamese learners",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tracy/web",
    "build": "npm run build --workspace=@tracy/web",
    "start": "npm run start --workspace=@tracy/web",
    "lint": "npm run lint --workspace=@tracy/web",
    "typecheck": "npm run typecheck --workspace=@tracy/web",
    "test": "npm run test --workspace=@tracy/web",
    "db:push": "npm run db:push --workspace=@tracy/web",
    "db:seed": "npm run db:seed --workspace=@tracy/web",
    "db:reset": "npm run db:reset --workspace=@tracy/web",
    "content:ingest": "python3 scripts/ingest/run_all.py",
    "content:stats": "python3 scripts/ingest/stats.py"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
